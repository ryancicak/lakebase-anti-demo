# Reference for every variable the demo reads. You probably do not need this
# file: `./bootstrap.sh` derives all of it from five inputs. See
# docs/BOOTSTRAP.md, and start from docs/bootstrap.env.example instead.
#
# This file remains the answer to "what does this variable do", and the manual
# path for anyone who wants to drive `./antidemo` directly. Never commit a real
# credential, account ID, ARN or workspace host here.

# --- Databricks --------------------------------------------------------------
# A ~/.databrickscfg profile name. bootstrap.sh writes one from service
# principal OAuth (M2M) credentials; `databricks auth login` also produces one.
DATABRICKS_PROFILE=anti-demo-your-workspace
# Round 4 seals this warehouse into its contract. bootstrap.sh derives it when
# the workspace has exactly one, and refuses to guess when it has several.
DATABRICKS_WAREHOUSE_ID=replace-with-warehouse-id
# The deployed app's service principal, sealed into the manifest by Round 4
# setup. bootstrap.sh derives it by creating or adopting the Databricks App.
DATABRICKS_APP_CLIENT_ID=replace-with-app-service-principal-client-id
# Round 6's Delta destination catalog. See docs/BOOTSTRAP.md.
# DATABRICKS_CDF_CATALOG=main
# Round 4's Unity Catalog. Read only on a first provision; after that the
# manifest's sealed value wins and a value that disagrees with it is refused
# rather than ignored. Defaults to main, the catalog a Unity Catalog-enabled
# workspace already has; set this only where main is absent or this principal
# cannot create schemas in it, which the installer refuses early and says.
# ROUND4_CATALOG=your_catalog
LAKEBASE_ENDPOINT_NAME=projects/lakebase-anti-demo/branches/production/endpoints/primary
LAKEBASE_DATABASE=anti_demo
# Optional locally; defaults to the authenticated Databricks user.
# LAKEBASE_USER=you@example.com

# --- The manifest ------------------------------------------------------------
# Required, with no default path: every command names the generation it operates
# on, so a stale generation can never be picked up silently. `./antidemo` does NOT
# set this for you. bootstrap.sh derives it — adopting the highest existing
# .anti-demo-v*/manifest.json, or creating .anti-demo-v7 — so under bootstrap
# this is not a variable a human handles.
ANTI_DEMO_MANIFEST=/absolute/path/to/owned/manifest.json

# --- AWS: choose exactly one auth source ------------------------------------
# Supplying AWS_PROFILE and ambient keys together is refused outright by
# server/aws_auth.py, and the manifest's recorded auth mode wins at runtime.
#
# Local profile/SSO (the default when ambient keys are absent):
AWS_PROFILE=your-sso-profile
# Or comment out AWS_PROFILE and provide the complete ambient pair. This is what
# bootstrap.sh uses, and it clears AWS_PROFILE for the run.
# AWS_ACCESS_KEY_ID=replace-at-runtime
# AWS_SECRET_ACCESS_KEY=replace-at-runtime
# AWS_SESSION_TOKEN=replace-at-runtime  # only for temporary credentials
# Required, with no default anywhere: server/cli.py refuses rather than guess,
# because a guessed region provisions real resources somewhere nobody chose.
# AWS_DEFAULT_REGION is accepted as a fallback; bootstrap.sh sets both.
AWS_REGION=replace-with-your-aws-region
AWS_EXPECTED_ACCOUNT_ID=000000000000
# Stable IAM user or role ARN, used by the app before STS AssumeRole. Bind the
# IAM ARN, never its transient arn:aws:sts::...:assumed-role/... form — an SSO
# role looks like
# arn:aws:iam::000000000000:role/aws-reserved/sso.amazonaws.com/<region>/AWSReservedSSO_<name>_<suffix>
# Unset, every Terraform path raises before Terraform runs
# (server/lifecycle.py:_terraform_variables). bootstrap.sh derives it from
# sts:GetCallerIdentity and only prompts when the identity is ambiguous.
ROUND5_APP_PRINCIPAL_ARN=arn:aws:iam::000000000000:role/replace-me
AURORA_CLUSTER_ID=lakebase-anti-demo
AURORA_SECRET_ARN=arn:aws:secretsmanager:us-west-2:000000000000:secret:replace-me
# Round 1 remains a control-plane-only capability check. Round 2 uses the same
# disposable RDS source to create and verify an isolated PITR restore.
RDS_INSTANCE_ID=lakebase-anti-demo-rds
RDS_SECRET_ARN=arn:aws:secretsmanager:us-west-2:000000000000:secret:replace-me
RDS_DATABASE=anti_demo

# Round 5 requires a complete sealed manifest v5. Its two
# database credential versions are written directly to owned Secrets Manager
# containers during setup; no Round 5 password or host override belongs here.
# Republish the sealed v5 manifest App resource before enabling deployed R5.

# --- Bounded arm behavior ----------------------------------------------------
ANTI_DEMO_ARM_TIMEOUT_SECONDS=900
ANTI_DEMO_ARM_POLL_SECONDS=5
# How long an armed fight card waits for the bell. A ring-release deadline, not
# a warmth guarantee -- each round re-establishes its own precondition after the
# bell. Sized for live presentation pacing rather than for the shortest window
# that still works.
ANTI_DEMO_ARM_TTL_SECONDS=180
ANTI_DEMO_COOLDOWN_TIMEOUT_SECONDS=900
ANTI_DEMO_COOLDOWN_POLL_TIMEOUT_SECONDS=30

# --- Bounded retention for a server that runs unattended ---------------------
# A session is created per bout attempt, abandoned attempts included, and each
# one holds a snapshot, its engines and its event log. These are what keep the
# process flat instead of growing by roughly a megabyte per attempt forever.
# A record is only ever released once it owns no task, no ring lease and no open
# cost window, so tightening these cannot cut a settling bout short. Receipts are
# on disk, so the recap and the scoreboard are unaffected by any of it.
ANTI_DEMO_SESSION_RETENTION_MAX=32
ANTI_DEMO_SESSION_RETENTION_SECONDS=900
# The newest few records are never released on age alone: a browser still holding
# one loses the screen it is presenting from on its next reconcile.
ANTI_DEMO_SESSION_RETENTION_FLOOR=4
# Per-session event-log ceiling. Sequence numbers stay stable across eviction and
# a consumer that resumes across it is told how many events it missed.
ANTI_DEMO_EVENT_LOG_MAX_EVENTS=500
