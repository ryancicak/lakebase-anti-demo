# Inputs for ./bootstrap.sh — copy to .env.bootstrap and fill in.
#
# .gitignore excludes .env.* so .env.bootstrap cannot be committed. This
# template is the only version that belongs in git; never put a real value here.
#
# See docs/BOOTSTRAP.md for what each of these unlocks and what is derived from
# them. Everything not listed below is derived: the AWS region, the AWS account
# ID, the Round 5 app principal ARN, the manifest path, the Databricks CLI
# profile, the SQL warehouse and the Databricks App service principal.
#
# bootstrap.sh also provisions .venv (uv sync --locked) and frontend/dist
# (npm ci && npm run build) before it provisions anything billed. Both are
# idempotent; --skip-install turns them off.

# --- Databricks: a workspace service principal's OAuth secret (M2M) ---------
# Not a personal access token, and not `databricks auth login` state.
DATABRICKS_HOST=https://dbc-00000000-0000.cloud.databricks.com
DATABRICKS_CLIENT_ID=replace-with-service-principal-client-id
DATABRICKS_CLIENT_SECRET=replace-at-runtime-never-commit

# --- AWS: a principal carrying policies 1-3 in docs/iam/ --------------------
# The fourth policy there is only for the opt-in S3 state backend. A default
# install needs no S3 access at all.
AWS_ACCESS_KEY_ID=replace-at-runtime-never-commit
AWS_SECRET_ACCESS_KEY=replace-at-runtime-never-commit

# That is the complete public setup contract. Bootstrap derives the AWS account,
# region (configured CLI region or the safe us-west-2 default), stable IAM
# principal, shared runtime trust, Databricks identities, app, warehouse,
# workspace resources, manifest path, and secret scope.
