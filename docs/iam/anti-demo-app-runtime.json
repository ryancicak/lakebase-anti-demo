{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConfirmOwnIdentityAtStartup",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "StartAndParkTheRoundFourAndSixGlueWritersOnly",
      "Effect": "Allow",
      "Action": [
        "glue:BatchStopJobRun",
        "glue:GetJobRun",
        "glue:GetJobRuns",
        "glue:StartJobRun"
      ],
      "Resource": [
        "arn:aws:glue:<AWS_REGION>:<AWS_ACCOUNT_ID>:job/lakebase-ant*-r4-writer-*",
        "arn:aws:glue:<AWS_REGION>:<AWS_ACCOUNT_ID>:job/lakebase-ant*-r6-writer-*"
      ]
    },
    {
      "Sid": "StartAndParkTheRoundSixDmsTasksOnly",
      "Effect": "Allow",
      "Action": [
        "dms:StartReplicationTask",
        "dms:StopReplicationTask"
      ],
      "Resource": "arn:aws:dms:<AWS_REGION>:<AWS_ACCOUNT_ID>:task:*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/anti-demo-round": "r6",
          "aws:ResourceTag/managed-by": "terraform"
        }
      }
    },
    {
      "Sid": "ReadTheRoundFourGlueRunMarkers",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::lakebase-ant*-r4-glue/markers/*"
    },
    {
      "Sid": "ReadRdsCatalogUnfiltered",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBClusters",
        "rds:DescribeDBInstanceAutomatedBackups",
        "rds:DescribeDBInstances",
        "rds:DescribeEvents",
        "rds:ListTagsForResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "<AWS_REGION>"
        }
      }
    },
    {
      "Sid": "RestoreSealedDatabasesIntoPerBoutArtifacts",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBInstance",
        "rds:RestoreDBClusterToPointInTime",
        "rds:RestoreDBInstanceToPointInTime"
      ],
      "Resource": [
        "arn:aws:rds:<AWS_REGION>:<AWS_ACCOUNT_ID>:cluster:adsc-*",
        "arn:aws:rds:<AWS_REGION>:<AWS_ACCOUNT_ID>:cluster:adrc-*",
        "arn:aws:rds:<AWS_REGION>:<AWS_ACCOUNT_ID>:db:adsc-*",
        "arn:aws:rds:<AWS_REGION>:<AWS_ACCOUNT_ID>:db:adrc-*",
        "arn:aws:rds:<AWS_REGION>:<AWS_ACCOUNT_ID>:cluster:lakebase-ant*",
        "arn:aws:rds:<AWS_REGION>:<AWS_ACCOUNT_ID>:db:lakebase-ant*",
        "arn:aws:rds:<AWS_REGION>:<AWS_ACCOUNT_ID>:subgrp:lakebase-ant*",
        "arn:aws:rds:<AWS_REGION>:<AWS_ACCOUNT_ID>:cluster-pg:*",
        "arn:aws:rds:<AWS_REGION>:<AWS_ACCOUNT_ID>:pg:*",
        "arn:aws:rds:<AWS_REGION>:<AWS_ACCOUNT_ID>:og:*"
      ]
    },
    {
      "Sid": "TagOnCreateSoTheReaperCanFindItsOwnResidue",
      "Effect": "Allow",
      "Action": "rds:AddTagsToResource",
      "Resource": [
        "arn:aws:rds:<AWS_REGION>:<AWS_ACCOUNT_ID>:cluster:adsc-*",
        "arn:aws:rds:<AWS_REGION>:<AWS_ACCOUNT_ID>:cluster:adrc-*",
        "arn:aws:rds:<AWS_REGION>:<AWS_ACCOUNT_ID>:db:adsc-*",
        "arn:aws:rds:<AWS_REGION>:<AWS_ACCOUNT_ID>:db:adrc-*"
      ]
    },
    {
      "Sid": "DeleteOnlyPerBoutArtifactsNeverASealedResident",
      "Effect": "Allow",
      "Action": [
        "rds:DeleteDBCluster",
        "rds:DeleteDBInstance"
      ],
      "Resource": [
        "arn:aws:rds:<AWS_REGION>:<AWS_ACCOUNT_ID>:cluster:adsc-*",
        "arn:aws:rds:<AWS_REGION>:<AWS_ACCOUNT_ID>:cluster:adrc-*",
        "arn:aws:rds:<AWS_REGION>:<AWS_ACCOUNT_ID>:db:adsc-*",
        "arn:aws:rds:<AWS_REGION>:<AWS_ACCOUNT_ID>:db:adrc-*"
      ]
    },
    {
      "Sid": "ReadRdsManagedMasterPasswordsOnly",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:rds!*"
    },
    {
      "Sid": "UseKmsThroughRdsAndSecretsManagerOnly",
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:GenerateDataKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": [
            "rds.<AWS_REGION>.amazonaws.com",
            "secretsmanager.<AWS_REGION>.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ReadCapacityEvidenceForRoundOne",
      "Effect": "Allow",
      "Action": "cloudwatch:GetMetricStatistics",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "<AWS_REGION>"
        }
      }
    },
    {
      "Sid": "ObserveEc2SoTheOrphanReaperCanSay",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "<AWS_REGION>"
        }
      }
    },
    {
      "Sid": "AssumeTheRoundFiveControlRole",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": [
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/anti-demo-runtime*",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/*-r5-exec-*"
      ]
    },
    {
      "Sid": "ListWhatCarriesTheLeaseAndTheRoundSixDmsLane",
      "Effect": "Allow",
      "Action": [
        "dms:DescribeReplicationInstances",
        "dms:DescribeReplicationTasks",
        "dms:ListTagsForResource",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVolumes",
        "ec2:DescribeVpcEndpoints",
        "secretsmanager:ListSecrets"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "<AWS_REGION>"
        }
      }
    },
    {
      "Sid": "ReadTheInstallationsOwnRolesAndQueues",
      "Effect": "Allow",
      "Action": [
        "iam:GetInstanceProfile",
        "iam:GetRole",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:ListPolicyTags",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ListQueueTags"
      ],
      "Resource": [
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/anti-demo-runtime*",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/i*-r4-*",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/i*-r5-*",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/r5-*",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:policy/anti-demo-runtime-*",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:policy/i*-r5-*",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:policy/r5-*",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:instance-profile/i*-r5-*",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:instance-profile/r5-*",
        "arn:aws:sqs:<AWS_REGION>:<AWS_ACCOUNT_ID>:i*-r5-*",
        "arn:aws:sqs:<AWS_REGION>:<AWS_ACCOUNT_ID>:r5-*"
      ]
    },
    {
      "Sid": "MoveOnlyTheExpiresAtLeaseOnTerraformMadeResources",
      "Effect": "Allow",
      "Action": [
        "dms:AddTagsToResource",
        "ec2:CreateTags",
        "iam:TagInstanceProfile",
        "iam:TagPolicy",
        "iam:TagRole",
        "rds:AddTagsToResource",
        "secretsmanager:TagResource",
        "sqs:TagQueue"
      ],
      "Resource": "*",
      "Condition": {
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "expires-at"
          ]
        },
        "StringEquals": {
          "aws:ResourceTag/managed-by": "terraform"
        },
        "Null": {
          "aws:ResourceTag/anti-demo-run-id": "false"
        }
      }
    },
    {
      "Sid": "MoveTheLeaseOnTheRoundFourAndSixGlueLanes",
      "Effect": "Allow",
      "Action": [
        "glue:GetTags",
        "glue:TagResource"
      ],
      "Resource": [
        "arn:aws:glue:<AWS_REGION>:<AWS_ACCOUNT_ID>:connection/lakebase-ant*-r4-*",
        "arn:aws:glue:<AWS_REGION>:<AWS_ACCOUNT_ID>:job/lakebase-ant*-r4-writer-*",
        "arn:aws:glue:<AWS_REGION>:<AWS_ACCOUNT_ID>:job/lakebase-ant*-r6-writer-*"
      ],
      "Condition": {
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "expires-at"
          ]
        }
      }
    },
    {
      "Sid": "MoveTheLeaseOnTheRoundFourAndSixBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketTagging",
        "s3:PutBucketTagging"
      ],
      "Resource": [
        "arn:aws:s3:::lakebase-ant*-r4-glue",
        "arn:aws:s3:::lakebase-ant*-r6-cdc"
      ]
    }
  ]
}
